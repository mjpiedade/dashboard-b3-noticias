<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz_tema"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/cartao_fundo"
    android:orientation="vertical">

    <!-- Cabeça clicável -->
    <LinearLayout
        android:id="@+id/cabeca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="top"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/selo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/selo_fundo"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:text="NEUTRO"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/texto"
                android:textSize="15sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.25"
                android:text="Título do tema" />

            <TextView
                android:id="@+id/n_noticias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto_muito_fraco"
                android:textSize="11sp"
                android:text="0 notícias" />
        </LinearLayout>

        <ImageView
            android:id="@+id/chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/ic_chevron"
            android:contentDescription="@string/expandir" />
    </LinearLayout>

    <!-- Corpo expansível (mostrado quando isExpandido) -->
    <LinearLayout
        android:id="@+id/corpo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingBottom="14dp"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="@color/borda" />

        <!-- Resumo -->
        <TextView
            android:id="@+id/bloco_resumo_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/resumo"
            android:textColor="@color/texto_muito_fraco"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/resumo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/texto"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4"
            android:text="" />

        <!-- Impacto -->
        <TextView
            android:id="@+id/bloco_impacto_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/impacto"
            android:textColor="@color/texto_muito_fraco"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/impacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/texto"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4"
            android:text="" />

        <!-- Notícias -->
        <TextView
            android:id="@+id/bloco_noticias_titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/noticias"
            android:textColor="@color/texto_muito_fraco"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:id="@+id/lista_noticias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />
    </LinearLayout>

</LinearLayout>
