<?xml version="1.0" encoding="utf-8"?>
<!--
  4x2 no launcher padrão do Android: ~250 dp de largura por ~110 dp de altura.
  minResize* menor permite ao utilizador encolher; targetCell* mantém o convite
  visual a ser 4x2 quando arrastar para o ecrã.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="90dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_noticias"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/widget_noticias"
    android:description="@string/widget_descricao" />
